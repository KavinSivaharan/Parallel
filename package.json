{
  "name": "parallel",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "db:migrate": "for file in apps/api/migrations/*.sql; do docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U parallel -d parallel < \"$file\"; done",
    "predev": "pnpm --filter './packages/**' build",
    "dev": "pnpm --parallel --filter @parallel/api --filter @parallel/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "pretypecheck": "pnpm --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
